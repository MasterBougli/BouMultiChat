<UserControl x:Class="BouMultiChat.App.StreamColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             MinWidth="320"
             MinHeight="520">
    <Border Margin="7"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="0.42*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock" FontSize="14" FontWeight="Bold" />
                    <TextBlock x:Name="PlatformTextBlock"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="44"
                        Padding="0"
                        Click="RemoveButtonClick"
                        ToolTip="Supprimer cette colonne"
                        Content="×"
                        FontSize="22" />
            </Grid>

            <Grid Grid.Row="1" Background="#0B0B10">
                <wv2:WebView2 x:Name="ChatWebView" DefaultBackgroundColor="#0B0B10" />
                <TextBlock x:Name="LoadingTextBlock"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Chargement sécurisé du chat…" />
                <Border x:Name="ErrorBorder"
                        Margin="18"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="#2A171B"
                        BorderBrush="#71313D"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorTextBlock" Foreground="#FFC2CB" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <GridSplitter Grid.Row="2"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Rows" />

            <Border Grid.Row="3" Background="#050507">
                <wv2:WebView2 x:Name="VideoWebView" DefaultBackgroundColor="#050507" />
            </Border>
        </Grid>
    </Border>
</UserControl>
