<UserControl x:Class="BouMultiChat.App.StreamColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             MinWidth="320"
             MinHeight="520">
    <Border Margin="7"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="0.42*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="13,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="9,6"
                        VerticalAlignment="Center"
                        Background="#272E3A"
                        BorderBrush="{StaticResource StrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock x:Name="PlatformBadgeTextBlock"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               FontSize="14"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="IdentifierTextBlock"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2"
                        Margin="0,0,6,0"
                        Padding="8,5"
                        VerticalAlignment="Center"
                        Background="#172116"
                        CornerRadius="12">
                    <TextBlock Foreground="#DCF9A6" FontSize="9" FontWeight="Bold" Text="ISOLÉ" />
                </Border>
                <Button Grid.Column="3"
                        Style="{StaticResource IconButtonStyle}"
                        Click="RemoveButtonClick"
                        ToolTip="Supprimer cette colonne"
                        AutomationProperties.Name="Supprimer cette colonne">
                    <Viewbox Width="17" Height="17">
                        <Path Data="M5,5 L19,19 M19,5 L5,19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" />
                    </Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Background="#0B0E14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Padding="12,0"
                        Background="#11151D"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,1">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               Text="CHAT EN DIRECT" />
                </Border>
                <wv2:WebView2 x:Name="ChatWebView"
                              Grid.Row="1"
                              DefaultBackgroundColor="#0B0E14" />
                <StackPanel x:Name="LoadingTextBlock"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Center" Fill="{StaticResource AccentBrush}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="Chargement sécurisé du chat…" />
                </StackPanel>
                <Border x:Name="ErrorBorder"
                        Grid.Row="1"
                        Margin="18"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{StaticResource DangerSurfaceBrush}"
                        BorderBrush="#71313D"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="#FFD2D9"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <GridSplitter Grid.Row="2"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource StrongBorderBrush}"
                          Cursor="SizeNS"
                          ResizeDirection="Rows"
                          ToolTip="Faire glisser pour redimensionner le chat et la vidéo" />

            <Grid Grid.Row="3" Background="#05070A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Padding="12,0"
                        Background="#11151D"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               Text="RETOUR VIDÉO" />
                </Border>
                <wv2:WebView2 x:Name="VideoWebView"
                              Grid.Row="1"
                              DefaultBackgroundColor="#05070A" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
