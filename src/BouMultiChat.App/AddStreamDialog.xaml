<Window x:Class="BouMultiChat.App.AddStreamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une colonne"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Foreground="{StaticResource AccentBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       Text="NOUVELLE COLONNE" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="26"
                       FontWeight="Bold"
                       Text="Ajouter un stream" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Plateforme" />
            <ComboBox x:Name="PlatformComboBox" Height="44" SelectedIndex="0">
                <ComboBoxItem Tag="Twitch" Content="Twitch" />
                <ComboBoxItem Tag="YouTube" Content="YouTube" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Nom de la colonne" />
            <TextBox x:Name="DisplayNameTextBox"
                     Height="44"
                     MaxLength="40"
                     Padding="12,10"
                     Text="Mon live" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Chaîne ou identifiant vidéo" />
            <TextBox x:Name="IdentifierTextBox"
                     Height="44"
                     MaxLength="64"
                     Padding="12,10" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Text="Twitch : nom de chaîne. YouTube : les 11 caractères après v=." />
            <TextBlock x:Name="ErrorTextBlock"
                       Margin="0,9,0,0"
                       Foreground="#FF889A"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,26,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Click="CancelButtonClick"
                    Content="Annuler" />
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Click="AddButtonClick"
                    IsDefault="True"
                    Content="Ajouter" />
        </StackPanel>
    </Grid>
</Window>
