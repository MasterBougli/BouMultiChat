<Window x:Class="BouMultiChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BouMultiChat"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="BouMultiChat" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="Tous vos lives. Un seul regard." />
                </StackPanel>
                <Button Grid.Column="1"
                        IsEnabled="False"
                        ToolTip="Disponible après l’intégration des colonnes"
                        Content="Ajouter une colonne" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border Width="620"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="SOCLE SÉCURISÉ ACTIF" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="32"
                               FontWeight="Bold"
                               Text="La régie prend forme" />
                    <TextBlock Margin="0,12,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="15"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Text="Le projet WPF est prêt. La validation stricte des domaines protège désormais la frontière entre les futurs chats web et l’application native." />
                    <Border Margin="0,26,0,0"
                            Padding="16"
                            Background="#1D2116"
                            BorderBrush="#40531B"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Foreground="#D9F7A1"
                                   TextWrapping="Wrap"
                                   Text="Prochaine étape : créer les colonnes WebView2 isolées, sans pont JavaScript vers .NET." />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
