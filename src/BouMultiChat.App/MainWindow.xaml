<Window x:Class="BouMultiChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="BouMultiChat"
        Width="1440"
        Height="860"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Closed="WindowClosed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="BouMultiChat" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="Tous vos lives. Un seul regard." />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="0,0,10,0"
                        IsEnabled="False"
                        ToolTip="Le contrôle du relais de délai arrive après les colonnes"
                        Content="Délai" />
                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddColumnButtonClick"
                        Content="Ajouter une colonne" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="9">
            <primitives:UniformGrid x:Name="ColumnsGrid" Columns="1" />

            <Border x:Name="EmptyState"
                    Width="620"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="RÉGIE PRÊTE" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="32"
                               FontWeight="Bold"
                               Text="Ajoutez votre premier live" />
                    <TextBlock Margin="0,12,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="15"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Text="Twitch et YouTube sont disponibles dans cette première version. Chaque chat et lecteur reste isolé du processus natif." />
                    <Button Margin="0,26,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddColumnButtonClick"
                            Content="Ajouter une colonne" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
