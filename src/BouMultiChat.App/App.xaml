<Application x:Class="BouMultiChat.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#09090D" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#14141B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30303B" />
        <SolidColorBrush x:Key="TextBrush" Color="#F7F7FB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAAAB8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C7FF37" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
